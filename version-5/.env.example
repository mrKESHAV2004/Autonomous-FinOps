# Copy to .env (never commit .env) and export before running, e.g.
#   set -a; source .env; set +a; uv run finops-web

# development | production | testing
FINOPS_ENV=development

# Required in production. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
FINOPS_SECRET_KEY=

FINOPS_MAX_UPLOAD_MB=50
FINOPS_UPLOAD_DIR=uploads
FINOPS_ARTIFACT_DIR=finops_artifacts

FINOPS_HOST=127.0.0.1
FINOPS_PORT=5000
FINOPS_DEBUG=0

FINOPS_LOG_LEVEL=INFO
# Defaults to 1 in production
FINOPS_LOG_JSON=0
