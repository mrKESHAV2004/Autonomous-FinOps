# Copy to .env (never commit .env) and export before running, e.g.
#   set -a; source .env; set +a; uv run finops-web
# docker compose reads .env by itself.

# development | production | testing
FINOPS_ENV=development

# Required in production. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
FINOPS_SECRET_KEY=

FINOPS_MAX_UPLOAD_MB=50
FINOPS_UPLOAD_DIR=uploads
FINOPS_ARTIFACT_DIR=finops_artifacts

FINOPS_HOST=127.0.0.1
FINOPS_PORT=5000
FINOPS_DEBUG=0

FINOPS_LOG_LEVEL=INFO
# Defaults to 1 in production
FINOPS_LOG_JSON=0

# Database: SQLite by default; PostgreSQL in production (needs the `postgres` extra):
#   postgresql+psycopg://finops:<password>@localhost:5432/finops
FINOPS_DATABASE_URL=sqlite:///finops.db
# Apply migrations at start-up. Defaults to 1 outside production; in production
# run `finops-db upgrade` instead.
FINOPS_AUTO_MIGRATE=1

# Set to run analyses on a separate `finops-worker`; leave empty to run them on
# a background thread in the web process.
FINOPS_REDIS_URL=

# Uploads with more data rows are rejected before anything is stored.
FINOPS_MAX_ROWS=2000000
# `finops-cleanup` deletes raw uploads older than this many days.
FINOPS_RETENTION_DAYS=90

# Sign-in ends after this many hours without activity.
FINOPS_SESSION_HOURS=8
# Rate limiting; 0 turns it off (refused in production).
FINOPS_RATE_LIMITS=1
# Number of reverse proxies in front of the app (reads X-Forwarded-For/-Proto).
# Leave 0 when clients connect directly.
FINOPS_TRUSTED_PROXIES=0

# Used by docker-compose.yml (local development only)
POSTGRES_PASSWORD=finops-dev
